# ESPHome secrets for the thermostat panel
# Copy this file to secrets.yaml (next to thermostat-panel.yaml) and fill in your values
# NEVER commit secrets.yaml to git!

wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"
panel_api_key: "generate-with-esphome"
panel_ap_password: "fallback-ap-password"
